{
  "name": "wms365-scanner",
  "version": "1.0.0",
  "private": true,
  "description": "Shared login-free WMS365 Scanner for Railway",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node scripts/run-node-tests.js",
    "test:audit": "playwright test --config=playwright.audit.config.js",
    "test:rbac": "node --test rbac.spec.js",
    "test:inventory-locking": "node --test inventory-locking.spec.js",
    "test:mobile-execution": "node --test mobile-execution.spec.js",
    "test:security-hardening": "node --test security-hardening.spec.js",
    "test:portal-isolation": "node --test portal-isolation.spec.js",
    "test:portal-item-picker": "node --test portal-order-item-picker.spec.js",
    "test:portal-password-reset": "node --test portal-password-reset.spec.js",
    "test:user-errors": "node --test user-facing-errors.spec.js",
    "test:platform-architecture": "node --test platform-architecture.spec.js",
    "audit:access-control": "node scripts/audit-access-control-coverage.js",
    "test:warehouse-billing": "node --test warehouse-billing.spec.js",
    "test:kitting-reservations": "node --test kitting-reservations.spec.js",
    "test:warehouse-entry-routes": "node --test warehouse-entry-routes.spec.js",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "check:deploy": "node --check server.js && node scripts/audit-access-control-coverage.js && node --test warehouse-entry-routes.spec.js && node scripts/run-node-tests.js",
    "test:guides": "node scripts/validate-guide-screenshots.js",
    "research:wms": "node scripts/audit-wms-feature-competitiveness.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^4.22.2",
    "nodemailer": "^9.1.0",
    "pg": "^8.13.1",
    "ssh2-sftp-client": "^12.0.1",
    "stripe": "^22.6.0"
  },
  "directories": {
    "doc": "docs"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "pg-mem": "^3.0.14"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wms365com-dev/wms365Scanner.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/wms365com-dev/wms365Scanner/issues"
  },
  "homepage": "https://github.com/wms365com-dev/wms365Scanner#readme"
}
